{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AMoncade/study-planner-app/docs/schema/cours.schema.json",
  "title": "Plan de cours extrait — contrat v1.0",
  "description": "Un fichier = un cours. Produit par Claude dans le chat à partir d'un PDF de plan de cours, consommé par Plan-Études. Voir docs/ARCHITECTURE.md §2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_file", "course", "evaluations", "totals", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "$ref": "#/$defs/date" },
    "source_file": { "type": "string", "minLength": 1 },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "term"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2,4}[0-9]{3,4}[A-Z]?$" },
        "title": { "type": "string", "minLength": 1 },
        "term": { "type": "string", "pattern": "^[AHE][0-9]{2}$" },
        "institution": { "type": ["string", "null"] },
        "credits": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "instructor": { "type": ["string", "null"] },
        "language": { "enum": ["fr", "en"], "default": "fr" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "effort_multiplier": { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0 },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" },
          "default": []
        }
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_weight_sum", "evaluation_count"],
      "properties": {
        "declared_weight_sum": { "type": "number", "minimum": 0 },
        "evaluation_count": { "type": "integer", "minimum": 1 }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nullableDate": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "nullableTime": {
      "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "weekday", "start", "end"],
      "properties": {
        "kind": { "enum": ["cours", "tp", "laboratoire", "atelier", "demonstration"] },
        "weekday": { "enum": ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"] },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "room": { "type": ["string", "null"], "default": null },
        "start_date": { "$ref": "#/$defs/nullableDate", "default": null },
        "end_date": { "$ref": "#/$defs/nullableDate", "default": null },
        "except_dates": {
          "type": "array",
          "items": { "$ref": "#/$defs/date" },
          "default": []
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "weight", "due_date", "confidence", "source_excerpt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{2,4}[0-9]{3,4}[A-Z]?-[A-Z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["examen_final", "examen_intra", "quiz", "travail", "projet",
                   "presentation", "laboratoire", "lecture", "participation", "autre"]
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "due_date": { "$ref": "#/$defs/nullableDate" },
        "due_time": { "$ref": "#/$defs/nullableTime", "default": null },
        "start_date": { "$ref": "#/$defs/nullableDate", "default": null },
        "duration_minutes": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "modality": {
          "oneOf": [
            { "enum": ["en_classe", "en_ligne_synchrone", "remise_en_ligne", "oral", "hors_classe"] },
            { "type": "null" }
          ],
          "default": null
        },
        "location": { "type": ["string", "null"], "default": null },
        "cumulative": { "type": ["boolean", "null"], "default": null },
        "group_work": { "type": ["boolean", "null"], "default": null },
        "content_scope": { "type": "array", "items": { "type": "string" }, "default": [] },
        "scope_units": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "deliverable": { "type": ["string", "null"], "default": null },
        "estimated_pages": { "type": ["integer", "null"], "minimum": 1, "default": null },
        "resources": { "type": "array", "items": { "type": "string" }, "default": [] },
        "notes": { "type": ["string", "null"], "default": null },
        "confidence": { "enum": ["high", "medium", "low"] },
        "source_excerpt": { "type": ["string", "null"] }
      }
    }
  }
}
