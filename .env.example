DATABASE_URL="file:./dev.db"

# AI engine. "ollama" (default) runs entirely on this PC via a local Ollama
# server: no API key, no cloud, no cost.
AI_PROVIDER="ollama"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_VISION_MODEL="llama3.2-vision"

# Optional: use Anthropic's cloud API instead of local Ollama.
# ANTHROPIC_API_KEY=""
# AI_PROVIDER="anthropic"  # optional: use the cloud API instead of local Ollama

# Optional: no AI at all — text files and typed PDFs only, cards generated by
# simple rules. Zero setup, works with nothing installed.
# AI_PROVIDER="offline"  # no AI at all: text/PDF only
