/* Thème sombre Plan-Études — aucun composant tiers (ARCHITECTURE §5.0). */

QWidget {
    background-color: #1e2126;
    color: #d6d9de;
    font-size: 13px;
}

QMainWindow, QStatusBar {
    background-color: #191c20;
}

QListWidget {
    background-color: #191c20;
    border: none;
    padding-top: 8px;
}

QListWidget::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 2px 6px;
}

QListWidget::item:selected {
    background-color: #2f6fed;
    color: white;
}

QTreeView, QTableWidget, QTableView, QPlainTextEdit {
    background-color: #23262c;
    alternate-background-color: #262a31;
    border: 1px solid #33373f;
    border-radius: 4px;
    selection-background-color: #2f6fed;
}

QHeaderView::section {
    background-color: #191c20;
    border: none;
    border-bottom: 1px solid #33373f;
    padding: 6px;
}

QPushButton {
    background-color: #2c313a;
    border: 1px solid #3c424d;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover { background-color: #363c47; }
QPushButton:pressed { background-color: #2f6fed; }
QPushButton:disabled { color: #6b7078; background-color: #24272d; }

QLineEdit, QComboBox, QTimeEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #23262c;
    border: 1px solid #3c424d;
    border-radius: 4px;
    padding: 4px 6px;
}

QTabWidget::pane { border: 1px solid #33373f; border-radius: 4px; }
QTabBar::tab {
    background: #23262c;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected { background: #2f6fed; color: white; }

QToolTip {
    background-color: #191c20;
    color: #d6d9de;
    border: 1px solid #3c424d;
}
